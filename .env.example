# 이 파일을 .env로 복사한 뒤 자리표시자를 실제 값으로 변경. Git에 .env를 올리지 않음.
DJANGO_SECRET_KEY=CHANGE_ME_GENERATED_SECRET
DB_PASSWORD=CHANGE_ME_APP_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_LOCAL_ONLY_ROOT_PASSWORD
DB_NAME=chatbot
DB_USER=chatbot
# 운영 EC2에서만 사용. https:// 또는 :3306을 붙이지 않음.
DB_HOST=RDS_ENDPOINT
BACKEND_IMAGE=ACCOUNT_ID.dkr.ecr.ap-northeast-2.amazonaws.com/chatbot-backend:IMAGE_TAG
DJANGO_ALLOWED_HOSTS=EC2_PUBLIC_DNS
DJANGO_CSRF_TRUSTED_ORIGINS=https://DISTRIBUTION_DOMAIN.cloudfront.net
CHATBOT_MODE=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# 기존 비공개 대화 저장 버킷. 비워 두면 내보내기 버튼을 숨김.
S3_EXPORT_BUCKET=
AWS_DEFAULT_REGION=ap-northeast-2
